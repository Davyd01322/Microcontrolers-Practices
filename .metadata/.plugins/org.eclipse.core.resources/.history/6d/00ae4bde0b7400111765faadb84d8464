#include "stm32f1xx.h"
int main(void){
	RCC->APB2ENR |= (1 << 3); //Enable GPIOC Clock
	GPIOB->CRL &= 0xFFF0FFFF; //Set C13 as Output
	GPIOB->CRL |= 0x00020000;
	while(1){
		//Blink LED in Blue-Pill C13 pin
		GPIOB->ODR &= (1 << 4);//~0x00002000;
		for(int i=0;i<100000;i++);/*Delay*/
	}
}
